{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "method_chaining_indentation": true,
        "no_superfluous_elseif": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": ["arrays", "arguments", "parameters"]
        }
    },
    "exclude": [
        "vendor",
        "node_modules",
        "storage",
        "bootstrap/cache",
        "public"
    ]
}